# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
/uploads
/public/uploads
# local SQLite files (root dev.db and prisma/dev.db) plus WAL sidecars
dev.db
dev.db-journal
dev.db-wal
dev.db-shm
.windsurf/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# local-only & AI-agent tooling — never commit
# These hold personal notes, private plans, security audit reports, per-machine
# credentials and editor state. None of it belongs in the repository.
/dev/
/prisma/seed-august.ts

# agent / AI-assistant config (machine-local: prompts, commands, sessions,
# worktrees, skill pins)
/.kilo/
/.agents/
/.claude/
/.cursor/
/.kilocode/
/.opencode/
/skills-lock.json

# editor state — personal keybindings, tasks and launch configs per machine
/.vscode/
