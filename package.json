{
  "name": "catarina",
  "version": "0.7.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "db:migrate": "npx prisma migrate dev",
    "db:push": "npx prisma db push --env-file=.env",
    "db:status": "npx prisma migrate status",
    "db:seed": "npx tsx --env-file=.env prisma/seed.ts",
    "db:seed-tables": "npx tsx --env-file=.env prisma/seed-tables.ts",
    "db:setup": "npx prisma db push --env-file=.env && npm run db:seed",
    "db:reset": "npx prisma migrate reset --force && npm run db:seed",
    "db:studio": "npx prisma studio",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@prisma/adapter-libsql": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "jose": "^6.2.4",
    "lucide-react": "^1.25.0",
    "next": "16.3.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "prisma": "^7.9.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "nanoid": "^3.3.18",
    "brace-expansion@^1.0.0": "1.1.18",
    "brace-expansion@^5.0.0": "5.0.9",
    "js-yaml@<4.3.2": "4.3.2",
    "fast-uri@<3.1.6": "3.1.6"
  }
}
