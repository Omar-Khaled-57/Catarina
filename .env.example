NEXT_PUBLIC_TEAM_NAME="Your Team"
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token"
JWT_SECRET="replace_with_32_or_more_random_characters"

# Rate limiting uses the same Turso database above (sliding window on the
# "rate_limit_events" table) — no separate service is needed.
#
# TRUSTED_IP_HEADER names the one request header your proxy overwrites with the
# real client IP. Only this header is read for per-IP rate-limit keys, so a
# client can't pick its own bucket. On Vercel, set it to "x-forwarded-for".
# Leaving it unset is safe but blunt: every visitor shares one IP bucket.
# TRUSTED_IP_HEADER="x-forwarded-for"

# The Drawers sync to the shared team cloud, stored in the Turso database
# above (DrawerSection table) — no external storage or OAuth is required.
