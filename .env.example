NEXT_PUBLIC_TEAM_NAME="Your Team"
NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
DATABASE_URL="libsql://your-db-name-your-org.turso.io"
TURSO_AUTH_TOKEN="your_turso_auth_token"
JWT_SECRET="any_random_string_here"

# Rate limiting uses the same Turso database above (sliding window on the
# "rate_limit_events" table) — no separate service or extra env vars needed.

# --- Google Drive storage (The Drawers) ------------------------------------
# Each signed-in user connects their own Google Drive (free 15 GB). The app
# creates a shared "Catarina" folder that teammates are granted access to.
# Set up: Google Cloud console → enable the Drive API, configure the OAuth
# consent screen, and create OAuth "Web application" credentials.
# Authorized redirect URI: <NEXT_PUBLIC_SITE_URL>/api/drive/callback
#GOOGLE_CLIENT_ID="XXXXX.apps.googleusercontent.com"
#GOOGLE_CLIENT_SECRET="XXXXX"
#GOOGLE_REDIRECT_URI="http://localhost:3000/api/drive/callback"
# Raw random string for encrypting OAuth tokens at rest (any long secret).
#DRIVE_TOKEN_KEY="replace_with_a_long_random_string"
# Optional: seed a root folder id instead of letting the app create "Catarina".
#DRIVE_ROOT_FOLDER_ID=""
